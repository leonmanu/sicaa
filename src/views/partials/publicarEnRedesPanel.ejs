<% if (typeof usuario !== 'undefined' && usuario && usuario.tipoModel == 'Ciie') { %>
<hr class="border-secondary mt-3 mb-3">
<button class="btn btn-outline-info fw-bold w-100" id="btnAbrirPublicar" type="button" data-curso-id="<%= curso._id %>">
    <i class="bi bi-megaphone me-2"></i>Publicar en redes sociales
</button>
<div class="small text-muted mt-2">Abre la vista previa con los textos para Facebook e Instagram. Todavía no publica nada.</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const btn = document.getElementById('btnAbrirPublicar');
    if (!btn) return;
    btn.addEventListener('click', async function () {
        btn.disabled = true;
        try {
            const response = await fetch('/publicaciones', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cursoLocalIds: [btn.dataset.cursoId] })
            });
            const result = await response.json();
            if (!result.success) throw new Error(result.error || 'No se pudo preparar la publicación.');
            window.location.href = `/publicaciones/${result.publicacion._id}/preview`;
        } catch (error) {
            alert(error.message);
            btn.disabled = false;
        }
    });
});
</script>
<% } %>
