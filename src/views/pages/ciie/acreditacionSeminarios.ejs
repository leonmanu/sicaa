<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Acreditación de seminarios</title>
    <style>
        #tablaAcreditacion tbody tr.fila-ok { background: rgba(25, 135, 84, 0.12); }
        #tablaAcreditacion tbody tr.fila-error { background: rgba(220, 53, 69, 0.15); }
        .estado-certificacion { font-size: 0.8rem; }
    </style>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

    <div class="container py-5">
        <h2 class="fw-bold mb-1"><i class="bi bi-patch-check-fill me-2 text-primary"></i>Acreditación de seminarios combinados</h2>
        <p class="text-muted mb-4">
            Un seminario acredita puntaje al combinarse con 2 extensiones. Este reporte revisa, uno por uno,
            los seminarios vinculados de tu CIIE contra el sitio oficial y muestra solo los que tienen
            docentes en condiciones de certificar (no certifica nada todavía).
        </p>

        <div class="card bg-dark border-secondary shadow-sm mb-4">
            <div class="card-body py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">Puede tardar varios minutos: se consulta un seminario a la vez para no saturar el sitio oficial.</span>
                <button type="button" class="btn btn-primary fw-bold" id="btnGenerarReporte">
                    <i class="bi bi-search me-1"></i>Generar reporte
                </button>
            </div>
        </div>

        <div id="resumenReporte" class="alert alert-info d-none mb-3"></div>

        <div id="bloqueResultados" class="d-none">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkTodos" checked>
                    <label class="form-check-label text-light" for="chkTodos">Seleccionar / deseleccionar todos</label>
                </div>
                <button type="button" class="btn btn-success fw-bold" id="btnCertificar">
                    <i class="bi bi-patch-check-fill me-1"></i>Certificar seleccionados
                </button>
            </div>

            <div id="resumenCertificacion" class="alert alert-info d-none mb-3"></div>

            <div class="card shadow-sm border-0 bg-dark text-white">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="tablaAcreditacion" class="table table-dark table-hover align-middle mb-0">
                            <thead class="bg-black text-muted small text-uppercase">
                                <tr>
                                    <th style="width:3%;"></th>
                                    <th>Seminario</th>
                                    <th>Año/Iti</th>
                                    <th>Pendientes</th>
                                    <th>Certificados</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyAcreditacion"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/scripts') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function wait(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        let pendientesEncontrados = [];

        function renderFila(item) {
            return `
                <tr class="fila-seminario" data-id-oferta="${item.idOfertaOficial}">
                    <td>
                        <input class="form-check-input chk-seminario" type="checkbox" checked
                            value="${item.idOfertaOficial}"
                            data-idcursooriginal="${item.idCursoOriginal}"
                            data-aprobados="${item.aprobados}"
                            data-cantcerti="${item.cantcerti}">
                    </td>
                    <td><div class="fw-bold" style="font-size:0.85rem;">${item.nombrePropuesta}</div></td>
                    <td><small class="text-muted">${item.anio ?? '-'} • I${item.itinerario ?? 0}</small></td>
                    <td><span class="badge bg-warning text-dark">${item.pendientesCantidad}</span></td>
                    <td><span class="badge bg-success">${item.certificados}</span></td>
                    <td class="estado-certificacion text-muted">Sin certificar</td>
                </tr>`;
        }

        document.getElementById('btnGenerarReporte').addEventListener('click', function () {
            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generando...';

            document.getElementById('bloqueResultados').classList.add('d-none');
            document.getElementById('tbodyAcreditacion').innerHTML = '';

            const resumen = document.getElementById('resumenReporte');
            resumen.classList.remove('d-none', 'alert-success', 'alert-danger');
            resumen.classList.add('alert-info');
            resumen.textContent = 'Iniciando revisión...';

            const eventSource = new EventSource('/ciie/acreditacion-seminarios/stream');

            eventSource.onmessage = function (event) {
                const data = JSON.parse(event.data);

                if (data.tipo === 'inicio') {
                    resumen.textContent = `Revisando 0 / ${data.total} seminarios...`;
                    if (data.total === 0) {
                        resumen.classList.remove('alert-info');
                        resumen.classList.add('alert-secondary');
                        resumen.textContent = 'No hay seminarios vinculados para revisar.';
                    }
                }

                if (data.tipo === 'progreso') {
                    const detalle = data.ok
                        ? (data.pendientes > 0 ? `${data.pendientes} pendiente/s` : 'sin pendientes')
                        : `error: ${data.error}`;
                    resumen.textContent = `Revisando ${data.actual} / ${data.total}: ${data.nombrePropuesta} (${detalle})`;
                }

                if (data.tipo === 'fin') {
                    eventSource.close();
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-search me-1"></i>Generar reporte';

                    pendientesEncontrados = data.pendientes || [];

                    if (pendientesEncontrados.length === 0) {
                        resumen.classList.remove('alert-info');
                        resumen.classList.add('alert-success');
                        resumen.textContent = 'Listo: no hay ningún seminario con combinaciones pendientes de certificar en este momento.';
                        return;
                    }

                    resumen.classList.remove('alert-info');
                    resumen.classList.add('alert-warning');
                    resumen.textContent = `Se encontraron ${pendientesEncontrados.length} seminario/s con combinaciones pendientes de certificar.`;

                    document.getElementById('tbodyAcreditacion').innerHTML = pendientesEncontrados.map(renderFila).join('');
                    document.getElementById('bloqueResultados').classList.remove('d-none');
                }
            };

            eventSource.onerror = function () {
                eventSource.close();
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-search me-1"></i>Generar reporte';
                resumen.classList.remove('alert-info');
                resumen.classList.add('alert-danger');
                resumen.textContent = 'Se cortó la conexión con el servidor antes de terminar el reporte.';
            };
        });

        document.getElementById('chkTodos').addEventListener('change', function () {
            document.querySelectorAll('.chk-seminario').forEach(chk => { chk.checked = this.checked; });
        });

        document.getElementById('btnCertificar').addEventListener('click', async function () {
            const seleccionados = Array.from(document.querySelectorAll('.chk-seminario:checked'));
            if (seleccionados.length === 0) {
                Swal.fire('Atención', 'Seleccioná al menos un seminario.', 'warning');
                return;
            }

            const confirm = await Swal.fire({
                icon: 'warning',
                title: 'Certificar seminarios',
                html: `Esto va a certificar oficialmente las combinaciones pendientes en <b>${seleccionados.length}</b> seminario/s en el sitio oficial. Esta acción no se puede deshacer desde acá.`,
                showCancelButton: true,
                confirmButtonText: 'Sí, certificar',
                cancelButtonText: 'Cancelar'
            });
            if (!confirm.isConfirmed) return;

            const btn = this;
            btn.disabled = true;

            const resumen = document.getElementById('resumenCertificacion');
            resumen.classList.remove('d-none', 'alert-success', 'alert-danger');
            resumen.classList.add('alert-info');

            let ok = 0, errores = 0;

            for (let i = 0; i < seleccionados.length; i++) {
                const chk = seleccionados[i];
                const fila = chk.closest('tr');
                const celda = fila.querySelector('.estado-certificacion');
                resumen.textContent = `Certificando ${i + 1} / ${seleccionados.length}...`;
                celda.textContent = 'Certificando...';

                try {
                    const response = await fetch('/ciie/acreditacion-seminarios/certificar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            idCursoOriginal: chk.dataset.idcursooriginal,
                            aprobados: chk.dataset.aprobados,
                            cantcerti: chk.dataset.cantcerti
                        })
                    });
                    const result = await response.json();
                    if (!result.success) throw new Error(result.error || 'No se pudo certificar.');

                    ok += 1;
                    fila.classList.add('fila-ok');
                    celda.innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i>Certificado';
                } catch (error) {
                    errores += 1;
                    fila.classList.add('fila-error');
                    celda.innerHTML = `<i class="bi bi-x-circle-fill text-danger me-1"></i>${error.message}`;
                }

                if (i < seleccionados.length - 1) {
                    const pausa = 1000 + Math.floor(Math.random() * 800);
                    await wait(pausa);
                }
            }

            btn.disabled = false;
            resumen.classList.remove('alert-info');
            resumen.classList.add(errores > 0 ? 'alert-danger' : 'alert-success');
            resumen.textContent = `Listo: ${ok} seminario/s certificados` + (errores > 0 ? `, ${errores} con error.` : '.');
        });
    </script>
</body>
</html>
