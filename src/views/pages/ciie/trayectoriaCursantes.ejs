<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Trayectoria de cursantes</title>
    <style>
        body { background: #eef1f5 !important; }
        .sheet-card {
            background: #fff;
            border: 1px solid #d7deea;
            border-radius: 16px;
            box-shadow: 0 10px 28px rgba(18, 36, 64, 0.08);
            overflow: hidden;
            margin-bottom: 1.25rem;
        }
        .sheet-header {
            background: linear-gradient(120deg, #ef7c1f, #f0a53a);
            color: #fff;
            padding: 16px 20px;
        }
        .sheet-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }
        .sheet-table th, .sheet-table td {
            border: 1px solid #d9e1ed;
            padding: 8px 10px;
            color: #243a57;
            vertical-align: top;
        }
        .sheet-table th {
            background: #f4f7fb;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.72rem;
            letter-spacing: 0.02em;
        }
        .badge-calificacion {
            font-size: 0.75rem;
        }
    </style>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

    <div class="container py-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-signpost-split me-2 text-warning"></i>Trayectoria de cursantes
                </h2>
                <p class="text-muted mb-0">Busca por DNI o por apellido y nombre para ver el recorrido de capacitaciones de un cursante.</p>
            </div>
            <a href="/ciie/certificados" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Volver a certificados
            </a>
        </div>

        <div class="card bg-dark border-secondary shadow-sm mb-4">
            <div class="card-body">
                <form action="/ciie/certificados/trayectoria-cursantes" method="get" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label text-light">DNI</label>
                        <input type="text" name="dni" class="form-control" placeholder="Ej: 30123456" value="<%= busqueda?.dni ?? '' %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-light">Apellido</label>
                        <input type="text" name="apellido" class="form-control" placeholder="Ej: Perez" value="<%= busqueda?.apellido ?? '' %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-light">Nombre</label>
                        <input type="text" name="nombres" class="form-control" placeholder="Ej: Maria" value="<%= busqueda?.nombres ?? '' %>">
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-warning text-dark fw-bold w-100">
                            <i class="bi bi-search me-1"></i>Buscar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <% const seHizoBusqueda = !!(busqueda && (busqueda.dni || busqueda.apellido || busqueda.nombres)); %>

        <% if (!seHizoBusqueda) { %>
            <div class="alert alert-secondary">
                Ingresa un DNI o un apellido y nombre para ver la trayectoria de un cursante.
            </div>
        <% } else if (!personas || personas.length === 0) { %>
            <div class="alert alert-secondary">
                No se encontraron cursantes que coincidan con la busqueda.
            </div>
        <% } else { %>
            <% personas.forEach(persona => { %>
                <div class="sheet-card">
                    <div class="sheet-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="mb-0"><%= persona.nombreCompleto || 'Sin nombre' %></h5>
                        <small>DNI: <strong><%= persona.dni || '-' %></strong> | Capacitaciones: <strong><%= persona.cursos.length %></strong></small>
                    </div>
                    <div class="p-3 bg-white text-dark table-responsive">
                        <table class="sheet-table">
                            <thead>
                                <tr>
                                    <th>Capacitacion</th>
                                    <th>Anio</th>
                                    <th>Cohorte</th>
                                    <th>Itinerario</th>
                                    <th>Dispositivo</th>
                                    <th>Area / Formador</th>
                                    <th>Calificacion</th>
                                    <th>Periodo cursada</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% persona.cursos.forEach(item => { %>
                                    <tr>
                                        <td><%= item.curso || '-' %></td>
                                        <td class="text-center"><%= item.anio ?? '-' %></td>
                                        <td class="text-center"><%= item.cohorte ?? '-' %></td>
                                        <td class="text-center"><%= item.itinerario ?? '-' %></td>
                                        <td><%= item.dispositivo || '-' %></td>
                                        <td>
                                            <%= item.area || '-' %>
                                            <% if (item.formador) { %><br><small class="text-muted"><%= item.formador %></small><% } %>
                                        </td>
                                        <td>
                                            <% const cal = item.calificacion || 'Sin Calificar'; %>
                                            <% const claseCal = cal === 'Aprobado' ? 'bg-success' : (cal === 'Desaprobado' ? 'bg-danger' : (cal === 'Ausente' ? 'bg-secondary' : 'bg-warning text-dark')); %>
                                            <span class="badge <%= claseCal %> badge-calificacion"><%= cal %></span>
                                        </td>
                                        <td style="font-size: 0.8rem;">
                                            <%= item.fechaInicioCursada ? new Date(item.fechaInicioCursada).toLocaleDateString('es-AR') : '-' %>
                                            -
                                            <%= item.fechaFinCursada ? new Date(item.fechaFinCursada).toLocaleDateString('es-AR') : '-' %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/scripts') %>
</body>
</html>
