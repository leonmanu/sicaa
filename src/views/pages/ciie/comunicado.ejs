<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Comunicado de itinerario</title>
    <style>
        body { background: #eef1f5 !important; }
        .sheet-card {
            background: #fff;
            border: 1px solid #d7deea;
            border-radius: 16px;
            box-shadow: 0 10px 28px rgba(18, 36, 64, 0.08);
            overflow: hidden;
        }
        .comunicado-header {
            padding: 18px 24px;
            border-bottom: 3px solid #222;
        }
        .comunicado-header-inner {
            display: flex;
            align-items: center;
            gap: 24px;
        }
        .comunicado-header-inner table { flex: 1; }
        .comunicado-logo {
            height: 60px;
            width: auto;
            object-fit: contain;
            flex-shrink: 0;
        }
        .comunicado-logo-ciie { height: 80px; }
        .comunicado-header table {
            width: 100%;
            border-collapse: collapse;
        }
        .comunicado-header table td {
            border: 1px solid #444;
            padding: 4px 8px;
            font-size: 0.85rem;
            color: #222;
        }
        .comunicado-header table td.label {
            width: 110px;
            font-weight: 700;
            background: #f4f7fb;
        }
        [contenteditable="true"] {
            outline: none;
            border-bottom: 1px dashed #99a;
            min-height: 1.1em;
        }
        [contenteditable="true"]:hover, [contenteditable="true"]:focus {
            background: #fffbe6;
        }
        .comunicado-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.82rem;
            table-layout: fixed;
        }
        .comunicado-table th, .comunicado-table td {
            border: 1px solid #333;
            padding: 6px 8px;
            color: #222;
            vertical-align: top;
        }
        .comunicado-table th {
            background: #e9edf3;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.72rem;
            letter-spacing: 0.02em;
            text-align: center;
        }
        .comunicado-table tr { break-inside: avoid; page-break-inside: avoid; }
        .dias-lista { line-height: 1.3; }
        @media print {
            @page { size: A4 landscape; margin: 8mm; }
            body { background: #fff !important; }
            .navbar, .no-print, .btn, .badge { display: none !important; }
            .container { max-width: none !important; width: 100% !important; padding: 0 !important; }
            .sheet-card { box-shadow: none !important; border: 0 !important; }
            .comunicado-table { font-size: 10px; }
            .comunicado-table th, .comunicado-table td { padding: 4px 5px; }
            [contenteditable="true"] { border-bottom: none; }
            .comunicado-logo { height: 18mm; -webkit-print-color-adjust: exact; }
            .comunicado-logo-ciie { height: 24mm; }
        }
    </style>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

    <div class="container py-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 no-print">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-megaphone me-2 text-warning"></i>Comunicado de itinerario
                </h2>
                <p class="text-muted mb-0">Elegí un itinerario para generar el comunicado. Podés editar cualquier texto haciendo clic sobre él antes de imprimir.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/ciie/subdashboard" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
                <button class="btn btn-outline-success btn-sm" onclick="descargarExcel()">
                    <i class="bi bi-file-earmark-excel me-1"></i>Descargar Excel
                </button>
                <button class="btn btn-outline-warning btn-sm" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>Imprimir
                </button>
            </div>
        </div>

        <div class="card bg-dark border-secondary shadow-sm mb-4 no-print">
            <div class="card-body">
                <form action="/ciie/comunicado" method="get" class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label text-light">Itinerario</label>
                        <select name="itinerarioClave" class="form-select" id="itinerarioClave" <%= itinerarios.length ? '' : 'disabled' %>>
                            <% if (itinerarios.length === 0) { %>
                                <option value="">No hay itinerarios disponibles</option>
                            <% } else { %>
                                <% itinerarios.forEach(item => { %>
                                    <% const selected = seleccion && item.anio === seleccion.anio && item.itinerario === seleccion.itinerario; %>
                                    <option
                                        value="<%= item.anio %>|<%= item.itinerario %>"
                                        data-anio="<%= item.anio %>"
                                        data-itinerario="<%= item.itinerario %>"
                                        <%= selected ? 'selected' : '' %>>
                                        <%= item.etiqueta %> (<%= item.cantidadCursos %> curso/s)
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                        <input type="hidden" name="anio" id="anio" value="<%= seleccion?.anio ?? '' %>">
                        <input type="hidden" name="itinerario" id="itinerario" value="<%= seleccion?.itinerario ?? '' %>">
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-warning text-dark fw-bold w-100" <%= itinerarios.length ? '' : 'disabled' %>>
                            <i class="bi bi-search me-1"></i>Generar comunicado
                        </button>
                    </div>
                </form>

                <% if (dispositivos.length > 0) { %>
                    <hr class="border-secondary">
                    <label class="form-label text-light mb-2">Dispositivos a mostrar</label>
                    <div id="filtroDispositivos" class="d-flex flex-wrap gap-3">
                        <% dispositivos.forEach(dispositivo => { %>
                            <div class="form-check">
                                <input class="form-check-input chk-dispositivo" type="checkbox" value="<%= dispositivo %>" id="chk-<%= dispositivo.replace(/\s+/g, '-') %>" checked>
                                <label class="form-check-label text-light" for="chk-<%= dispositivo.replace(/\s+/g, '-') %>">
                                    <%= dispositivo %>
                                </label>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="sheet-card">
            <div class="comunicado-header">
                <div class="comunicado-header-inner">
                    <img src="/img/logo%20ciie%20luz%20blanca26.png" alt="CIIE 201 Julio R. Cao - Laferrere" class="comunicado-logo comunicado-logo-ciie">
                    <table>
                        <tr>
                            <td class="label">Fecha:</td>
                            <td contenteditable="true"></td>
                        </tr>
                        <tr>
                            <td class="label">Nivel:</td>
                            <td contenteditable="true">Todos</td>
                        </tr>
                        <tr>
                            <td class="label">Emite:</td>
                            <td contenteditable="true">CIIE 201 - <%= (comunicado.ciie?.nombre || '').replace(/^ciie\s+/i, '') || 'Laferrere' %></td>
                        </tr>
                        <tr>
                            <td class="label">Destino:</td>
                            <td contenteditable="true">Todos los docentes</td>
                        </tr>
                        <tr>
                            <td class="label">Objeto:</td>
                            <td contenteditable="true">Propuestas formativas <%= seleccion?.anio || '' %> - Itinerario <%= seleccion?.itinerario || '' %></td>
                        </tr>
                        <tr>
                            <td class="label">Inscripción:</td>
                            <td contenteditable="false"><a href="https://sicaa.onrender.com/curso/publico/ciie06901" target="_blank" rel="noopener">https://sicaa.onrender.com/curso/publico/ciie06901</a></td>
                        </tr>
                    </table>
                    <img src="/img/logo-pba2.png" alt="Gobierno de la Provincia de Buenos Aires" class="comunicado-logo">
                </div>
            </div>

            <div class="p-3 bg-white text-dark">
                <% if (comunicado.cursos && comunicado.cursos.length > 0) { %>
                    <div class="table-responsive">
                        <table class="comunicado-table">
                            <thead>
                                <tr>
                                    <th style="width: 7%;">Nivel</th>
                                    <th style="width: 12%;">Área</th>
                                    <th>Nombre del curso</th>
                                    <th style="width: 8%;">Dispositivo</th>
                                    <th style="width: 12%;">Formador/a</th>
                                    <th style="width: 10%;">Días de cursada</th>
                                    <th style="width: 8%;">Hora</th>
                                    <th style="width: 8%;">Formato</th>
                                    <th style="width: 10%;">Inscripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% comunicado.cursos.forEach(curso => { %>
                                    <tr data-dispositivo="<%= curso.dispositivo %>">
                                        <td contenteditable="true"><%= curso.nivel %></td>
                                        <td contenteditable="true"><%= curso.area %></td>
                                        <td contenteditable="true"><em><%= curso.nombreCurso %></em></td>
                                        <td contenteditable="true"><%= curso.dispositivo %></td>
                                        <td contenteditable="true"><%= curso.formador %></td>
                                        <td class="dias-lista" contenteditable="true">
                                            <% if (curso.diasCursada.length > 0) { %>
                                                <%- curso.diasCursada.join('<br>') %>
                                            <% } %>
                                        </td>
                                        <td contenteditable="true"><%= curso.hora %></td>
                                        <td contenteditable="true"><%= curso.formato %></td>
                                        <td>
                                            <% if (curso.enlaceInscripcion) { %>
                                                <a href="<%= curso.enlaceInscripcion %>" target="_blank" rel="noopener"><%= curso.enlaceInscripcion %></a>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="alert alert-secondary mb-0">
                        No hay cursos vinculados para el itinerario seleccionado.
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/scripts') %>
    <script>
        (function () {
            const select = document.getElementById('itinerarioClave');
            const anioInput = document.getElementById('anio');
            const itinerarioInput = document.getElementById('itinerario');

            function syncHiddenFields() {
                if (!select || !select.value) {
                    anioInput.value = '';
                    itinerarioInput.value = '';
                    return;
                }
                const [anio, itinerario] = select.value.split('|');
                anioInput.value = anio || '';
                itinerarioInput.value = itinerario || '';
            }

            if (select) {
                select.addEventListener('change', syncHiddenFields);
                syncHiddenFields();
            }
        })();

        (function () {
            const checks = document.querySelectorAll('.chk-dispositivo');
            if (checks.length === 0) return;

            function aplicarFiltro() {
                const activos = new Set(
                    Array.from(checks).filter(c => c.checked).map(c => c.value)
                );
                document.querySelectorAll('.comunicado-table tbody tr[data-dispositivo]').forEach(fila => {
                    fila.style.display = activos.has(fila.dataset.dispositivo) ? '' : 'none';
                });
            }

            checks.forEach(c => c.addEventListener('change', aplicarFiltro));
            aplicarFiltro();
        })();

        function descargarExcel() {
            const headerTable = document.querySelector('.comunicado-header table');
            const dataTable = document.querySelector('.comunicado-table');
            if (!dataTable) return;

            const dataTableClon = dataTable.cloneNode(true);
            dataTableClon.querySelectorAll('tbody tr[data-dispositivo]').forEach(fila => {
                if (fila.style.display === 'none') fila.remove();
            });

            const html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" '
                + 'xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">'
                + '<head><meta charset="UTF-8">'
                + '<!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet>'
                + '<x:Name>Comunicado</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>'
                + '</x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->'
                + '</head><body>'
                + (headerTable ? headerTable.outerHTML : '')
                + '<br>'
                + dataTableClon.outerHTML
                + '</body></html>';

            const blob = new Blob(['﻿' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
            const url = URL.createObjectURL(blob);

            const anio = document.getElementById('anio')?.value || '';
            const itinerario = document.getElementById('itinerario')?.value || '';
            const nombreArchivo = 'comunicado-itinerario'
                + (anio ? `-${anio}` : '')
                + (itinerario ? `-${itinerario}` : '')
                + '.xls';

            const a = document.createElement('a');
            a.href = url;
            a.download = nombreArchivo;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
    </script>
</body>
</html>
