<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Listas para firmar por itinerario</title>
    <style>
        @media print {
            @page { size: A4 landscape; margin: 0.5cm 0.8cm; }
            .no-print { display: none !important; }
            .page-break { page-break-after: always; }
            body { background: #fff !important; color: #000 !important; }
        }
        .hoja-print {
            background: #fff;
            color: #000;
            font-family: Arial, sans-serif;
        }
        .font-small { font-size: 0.8rem; }
        .font-xsmall { font-size: 0.55rem; color: #777; }
        .tabla-print {
            border-collapse: collapse;
            width: 100%;
            table-layout: fixed;
        }
        .tabla-print th, .tabla-print td {
            border: 1px solid #000 !important;
            padding: 2px 6px;
            vertical-align: middle;
            height: 30px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
        .titulo-recortado {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 0;
        }
    </style>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

    <div class="container py-5 no-print">
        <h2 class="fw-bold mb-1"><i class="bi bi-pencil-square me-2 text-primary"></i>Listas para firmar por itinerario</h2>
        <p class="text-muted mb-4">Un solo documento con la planilla de asistencia (para firmar) de todos los cursos del itinerario.</p>

        <div class="card bg-dark border-secondary shadow-sm mb-4">
            <div class="card-body py-3">
                <form action="/ciie/lista-asistencia-masiva" method="get" class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label text-light small">Itinerario</label>
                        <select name="itinerarioClave" class="form-select" id="itinerarioClave" <%= itinerarios.length ? '' : 'disabled' %>>
                            <% if (itinerarios.length === 0) { %>
                                <option value="">No hay itinerarios disponibles</option>
                            <% } else { %>
                                <% itinerarios.forEach(item => { %>
                                    <% const selected = seleccion && item.anio === seleccion.anio && item.itinerario === seleccion.itinerario; %>
                                    <option value="<%= item.anio %>|<%= item.itinerario %>" <%= selected ? 'selected' : '' %>>
                                        <%= item.etiqueta %> (<%= item.cantidadCursos %> curso/s)
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                        <input type="hidden" name="anio" id="anio" value="<%= seleccion?.anio ?? '' %>">
                        <input type="hidden" name="itinerario" id="itinerario" value="<%= seleccion?.itinerario ?? '' %>">
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100" <%= itinerarios.length ? '' : 'disabled' %>>
                            <i class="bi bi-search me-1"></i>Ver itinerario
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <% if (seleccion && cursos.length > 0) { %>
            <button class="btn btn-outline-warning" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Imprimir / Guardar como PDF (<%= cursos.length %> curso/s)
            </button>
        <% } %>
    </div>

    <% if (seleccion && cursos.length === 0) { %>
        <div class="container no-print"><div class="alert alert-secondary">No hay cursos para este itinerario.</div></div>
    <% } %>

    <% cursos.forEach((curso, idxCurso) => {
        const inscriptosTotal = curso.inscriptosLocales.length;
        const limit = 18;
        const hojas = Math.ceil(inscriptosTotal / limit) || 1;
        const colspanEncuentros = curso.encuentros.length || 1;
    %>
        <% for (let x = 1; x <= hojas; x++) { %>
            <div class="hoja-print px-3 py-2 <%= (x < hojas || idxCurso < cursos.length - 1) ? 'page-break' : '' %>">
                <div class="d-flex justify-content-between align-items-end gap-3 font-small">
                    <div>
                        <%= curso.dispositivo %> | <%= curso.cargoId?.clave || '' %> |
                        <%= curso.anio %> • I<%= curso.itinerario %> | idabc: <%= curso.idOfertaOficial || 'sin vincular' %> |
                        <strong>Formador:</strong> <%= curso.formadorAbc %>
                    </div>
                    <div class="text-uppercase fw-bold text-muted" style="font-size:9px;">Hoja <%= x %> / <%= hojas %></div>
                </div>
                <div class="titulo-recortado">
                    <h5 class="mb-1">
                        <strong><%= curso.cargoId?.areaId?.nombre || '' %></strong>:
                        <span class="text-muted fw-normal small"><%= curso.nombrePropuesta %></span>
                    </h5>
                </div>
                <hr class="mt-0 mb-2" style="border-top:2px solid #000; opacity:1;">

                <table class="tabla-print">
                    <thead>
                        <% if (x === 1) { %>
                            <tr class="text-center" style="background:#eee;">
                                <th rowspan="2" style="width:25%;">Apellido y Nombre</th>
                                <th rowspan="2" style="width:8%;">DNI</th>
                                <th colspan="<%= colspanEncuentros %>">Encuentros : Fechas</th>
                                <th rowspan="2" style="width:10%;">Observaciones</th>
                            </tr>
                            <tr style="background:#eee;">
                                <% if (curso.encuentros.length === 0) { %>
                                    <th style="width:50px;"><small>1°:</small></th>
                                <% } %>
                                <% curso.encuentros.forEach(enc => { %>
                                    <th style="width:50px;"><small><%= enc.numero %>°:</small></th>
                                <% }) %>
                            </tr>
                        <% } %>
                    </thead>
                    <tbody>
                        <% for (let y = limit * (x - 1); y < limit * x; y++) {
                            const nro = y + 1;
                        %>
                            <tr>
                                <% if (y < inscriptosTotal) {
                                    const insc = curso.inscriptosLocales[y];
                                %>
                                    <td class="text-uppercase font-small"><strong><%= nro %>)</strong> <%= insc.apellido %>, <%= insc.nombres %></td>
                                    <td class="text-center font-small"><%= insc.dni || '' %></td>
                                <% } else { %>
                                    <td class="font-small text-muted"><strong><%= nro %>)</strong></td>
                                    <td></td>
                                <% } %>
                                <% for (let j = 1; j <= colspanEncuentros; j++) { %>
                                    <td class="position-relative">
                                        <span class="font-xsmall position-absolute top-0 start-0 ps-1"><%= nro %></span>
                                    </td>
                                <% } %>
                                <td class="position-relative" style="width:10%;">
                                    <span class="font-xsmall position-absolute top-0 start-0 ps-1"><%= nro %></span>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>

                <div class="d-flex justify-content-between text-center font-small mt-2" style="max-width: 620px;">
                    <div style="width: 280px;">
                        <div style="border-top: 1px solid #000; padding-top: 5px;"><strong>Firma del Formador</strong></div>
                    </div>
                    <div style="width: 280px;">
                        <div style="border-top: 1px solid #000; padding-top: 5px;"><strong>Firma del Receptor</strong></div>
                    </div>
                </div>
            </div>
        <% } %>
    <% }) %>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/scripts') %>
    <script>
        (function () {
            const select = document.getElementById('itinerarioClave');
            const anioInput = document.getElementById('anio');
            const itinerarioInput = document.getElementById('itinerario');
            function syncHiddenFields() {
                if (!select || !select.value) { if (anioInput) anioInput.value=''; if (itinerarioInput) itinerarioInput.value=''; return; }
                const [anio, itinerario] = select.value.split('|');
                anioInput.value = anio || '';
                itinerarioInput.value = itinerario || '';
            }
            if (select) { select.addEventListener('change', syncHiddenFields); syncHiddenFields(); }
        })();
    </script>
</body>
</html>
