<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Certificados</title>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        /* ─── Pantalla ───────────────────────────────────── */
        body { background: #eef1f5 !important; }
        
        .contenedor-nombre-curso {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 60px;
            margin: 10px 0;
            text-align: center;
        }
        .cert-wrapper {
            background: white;
            border: 1.5px solid #0f9db0;
            border-radius: 12px;
            margin: 20px auto;
            max-width: 800px;
            overflow: hidden;
            transition: opacity 0.2s;
            color: #1a1a1a;
            position: relative;
        }
        .cert-wrapper.deseleccionado { opacity: 0.35; }
        .estado-impresion { font-size: 0.75rem; margin-left: auto; white-space: nowrap; }
        .btn-toggle-impreso { font-size: 0.75rem; }
        
        .cert-selector-bar {
            background: #1a2a3a;
            padding: 8px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.9rem;
            color: #aac;
        }

        /* ─── Diseño del Certificado ────────────────────── */
        .cert-page {
            padding: 25px 35px 10px;
            position: relative;
        }

        .cert-page::before {
            content: '';
            position: absolute;
            inset: 10px;
            border: 2px solid #0b6b77;
            pointer-events: none;
        }
        .cert-page::after {
            content: '';
            position: absolute;
            inset: 14px;
            border: 0.5px solid #cde8ec;
            pointer-events: none;
        }

        .cert-inner { position: relative; z-index: 1; }

        .cert-ref {
            font-size: 9px;
            color: #666;
            text-align: right;
            margin-bottom: 10px;
        }

        .cert-cuerpo {
            font-family: Arial, sans-serif;
            font-size: 15px;
            line-height: 1.6;
            text-align: justify;
        }
        
        .cert-nombre-linea {
            text-align: center;
            overflow: hidden;
            margin: 2px 0 6px;
        }

        .cert-nombre {
            font-size: 20px;
            font-weight: 700;
            color: #0b6b77;
            display: inline-block;
            white-space: nowrap;
            max-width: 100%;
        }

        .cert-nombre-curso {
            font-size: 22px;
            font-family: 'Crimson Pro', serif;
            font-style: italic;
            font-weight: 700;
            color: #1a1a1a;
        }

        .cert-lugar {
            font-size: 13px;
            font-weight: 700;
            text-align: right;
        }

        .cert-firmas {
            display: flex;
            justify-content: space-around;
            margin-top: 25px;
            padding-bottom: 10px;
        }

        .firma-bloque { text-align: center; width: 40%; }
        .firma-linea { border-top: 1px solid #333; margin-bottom: 5px; }
        .firma-label { font-size: 10px; color: #666; }

        .cert-footer {
            padding: 15px 0 25px;
            display: flex;
            justify-content: center;
        }
        .cert-header-logo { height: 60px; width: auto; object-fit: contain; }

        /* ─── Impresión ──────────────────────────────────── */
        @media print {
            @page {
                size: A4;
                margin: 0; /* Importante: margen cero para control total */
            }
            .container {
                width: 100% !important;
                max-width: none !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            body { background: white !important; margin: 0; padding: 0; }
            .no-print, .navbar, .cert-selector-bar, .card { display: none !important; }
            /* Solo se imprime lo seleccionado (antes los destildados salían igual) */
            .cert-wrapper.deseleccionado { display: none !important; }

            .cert-wrapper {
                /* Mitad exacta de una A4 (297mm / 2) */
                height: 148.5mm; 
                width: 210mm;
                margin: 0 !important;
                border: none !important;
                border-radius: 0 !important;
                display: flex;
                flex-direction: column;
                page-break-inside: avoid;
                box-sizing: border-box;
                position: relative;
            }

            /* Línea divisoria (Solo para el primer certificado de cada hoja) */
            .cert-wrapper:nth-child(odd)::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                border-bottom: 1px dashed #ccc; /* Línea gris suave para corte */
                z-index: 10;
            }

            .cert-wrapper:nth-child(2n) {
                page-break-after: always;
            }

            .cert-page {
                flex: 1;
                padding: 10mm 15mm 18mm !important;
            }

            .cert-page::before { inset: 8mm !important; border-width: 1.5pt !important; -webkit-print-color-adjust: exact; }
            .cert-page::after { inset: 9.5mm !important; -webkit-print-color-adjust: exact; }

            .cert-footer {
                height: 30mm;
                padding: 0 0 20mm 0;
                align-items: center;
            }

            .cert-header-logo {
                height: 20mm !important;
                -webkit-print-color-adjust: exact;
            }

            .cert-cuerpo { font-size: 12pt !important; }
            .cert-nombre-curso { font-size: 16pt !important; }
        }
    </style>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 no-print">
            <div>
                <h2 class="fw-bold mb-1"><i class="bi bi-patch-check me-2 text-success"></i>Certificados</h2>
                <p class="text-muted mb-0">Seleccioná los certificados a imprimir. Vienen marcados los que todavía no se imprimieron.</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-light btn-sm" id="btnSelTodos">Seleccionar todos</button>
                <button class="btn btn-outline-warning btn-sm" id="btnSelPendientes">Solo pendientes</button>
                <button class="btn btn-outline-info btn-sm" id="btnOrdenAlpha">
                    <i class="bi bi-sort-alpha-down me-1"></i>Ordenar por apellido
                </button>
                <button class="btn btn-success fw-bold" id="btnImprimir">
                    <i class="bi bi-printer me-1"></i>Imprimir <span class="badge bg-white text-success ms-1" id="contadorSeleccionados">0</span>
                </button>
                <a href="/ciie/calificaciones" class="btn btn-outline-secondary btn-sm">Volver</a>
            </div>
        </div>

        <% if (cursosDocumentos && cursosDocumentos.length > 0) { %>
            <% cursosDocumentos.forEach(data => { %>
                <div class="curso-grupo">
                    <div class="card bg-dark border-secondary mb-4 no-print">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-0 text-white"><%= data.curso?.nombrePropuesta %></h5>
                                <small class="text-muted">Oferta: <%= data.curso?.idOfertaOficial %></small>
                            </div>
                            <span class="badge bg-secondary resumen-impresion" data-oferta="<%= data.curso?.idOfertaOficial %>">
                                <%= data.curso?.certificadosImpresos || 0 %> de <%= data.curso?.certificadosTotal || 0 %> impresos
                            </span>
                        </div>
                    </div>

                    <div class="certs-container">
                    <% data.certificados.forEach((item, index) => { %>
                        <div class="cert-wrapper<%= item.impreso ? ' deseleccionado' : '' %>" data-cert-id="cert-<%= data.curso?.idOfertaOficial %>-<%= index %>" data-nombre="<%= item.nombreCompleto %>"
                             data-oferta="<%= data.curso?.idOfertaOficial %>" data-dni="<%= item.dni %>"
                             data-impreso="<%= item.impreso ? '1' : '0' %>" data-inscripcion="<%= item.tieneInscripcion ? '1' : '0' %>">

                            <div class="cert-selector-bar no-print">
                                <input type="checkbox" class="form-check-input check-cert"
                                       id="chk-<%= data.curso?.idOfertaOficial %>-<%= index %>"
                                       data-cert-id="cert-<%= data.curso?.idOfertaOficial %>-<%= index %>" <%= item.impreso ? '' : 'checked' %>>
                                <label for="chk-<%= data.curso?.idOfertaOficial %>-<%= index %>">
                                    <strong><%= item.nombreCompleto %></strong> (DNI <%= item.dni %>)
                                </label>
                                <span class="estado-impresion"
                                      data-fecha="<%= item.fechaImpresion ? new Date(item.fechaImpresion).toISOString() : '' %>"
                                      data-veces="<%= item.vecesImpreso || 0 %>"></span>
                            </div>

                            <div class="cert-page">
                                <div class="cert-inner">
                                    <div class="cert-ref">
                                        <small>
                                            <% if (data.curso?.siglaDispositivo) { %><%= data.curso.siglaDispositivo %> <% } %> | <%= data.administrativos?.cursoClave.toUpperCase() %> |
                                        <%= data.curso?.anio %> • <%= data.curso?.itinerario %>
                                        </small>
                                    </div>

                                    <div class="cert-cuerpo">
                                        <p style="text-align:center; margin-bottom:2px;">
                                            Se deja constancia que
                                        </p>
                                        <div class="cert-nombre-linea">
                                            <span class="cert-nombre"><%= item.nombreCompleto %></span>
                                        </div>
                                        <p style="text-align:center; margin-top:2px;">
                                            DNI: <strong><%= item.dni %></strong>, cursó y aprobó la propuesta formativa:
                                        </p>

                                        <div class="contenedor-nombre-curso">
                                            <span class="cert-nombre-curso"><%= data.curso?.nombrePropuesta %></span>
                                        </div>

                                        <p>
                                            Proyecto N°: <strong><%= data.administrativos?.proyecto %></strong>, 
                                            carga horaria de <strong><%= data.administrativos?.horas %> hs. reloj</strong>,
                                            desde el <%= new Date(data.curso.fechaInicioCurso).toLocaleDateString('es-AR') %>
                                            hasta el <%= new Date(data.curso.fechaFinCurso).toLocaleDateString('es-AR') %>.
                                        </p>
                                        <p>
                                            Resolución N° <%= data.administrativos?.resolucion %>, 
                                            Dictamen N° <%= data.administrativos?.dictamen %>.
                                        </p>
                                    </div>

                                    <div class="cert-lugar">
                                        <%= data.institucion?.distrito %> (<%= data.institucion?.localidad %>), <%= new Date(data.curso.fechaFinCurso).toLocaleDateString('es-AR', {day:'numeric', month:'long', year:'numeric'}) %>.
                                    </div>
                                    <br>
                                    <div class="cert-firmas">
                                        <div class="firma-bloque">
                                            <div class="firma-linea"></div>
                                            <div class="firma-label">Form. <%= data.curso?.formadorAbc %></div>
                                        </div>
                                        <div class="firma-bloque">
                                            <div class="firma-linea"></div>
                                            <div class="firma-label">Director/a CIIE</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="cert-footer">
                                <img src="/img/logo-pba2.png" alt="Logo" class="cert-header-logo">
                            </div>
                        </div>
                    <% }) %>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/scripts') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // ─── Impresión por inscripción ───────────────────────────────────────
        function pintarEstadoImpresion(wrapper) {
            const $w = $(wrapper);
            const $estado = $w.find('.estado-impresion').empty();
            if ($w.attr('data-inscripcion') !== '1') {
                $estado.append($('<span class="text-warning"></span>')
                    .attr('title', 'El DNI no coincide con ninguna inscripción del sistema: no se puede registrar la impresión.')
                    .html('<i class="bi bi-exclamation-triangle me-1"></i>Sin inscripción en el sistema'));
                return;
            }
            const impreso = $w.attr('data-impreso') === '1';
            if (impreso) {
                const fecha = $estado.attr('data-fecha');
                const veces = Number($estado.attr('data-veces') || 0);
                const texto = `Impreso${fecha ? ' el ' + new Date(fecha).toLocaleDateString('es-AR') : ''}${veces > 1 ? ` (${veces} veces)` : ''}`;
                $estado.append($('<span class="text-success me-2"></span>').html('<i class="bi bi-check-circle-fill me-1"></i>').append(document.createTextNode(texto)));
            } else {
                $estado.append('<span class="text-muted me-2"><i class="bi bi-circle me-1"></i>Sin imprimir</span>');
            }
            $estado.append($('<button type="button" class="btn btn-link btn-sm p-0 btn-toggle-impreso"></button>')
                .text(impreso ? 'Desmarcar' : 'Marcar como impreso'));
        }

        function actualizarResumenes() {
            $('.resumen-impresion').each(function () {
                const oferta = $(this).data('oferta');
                const $certs = $(`.cert-wrapper[data-oferta="${oferta}"]`);
                const impresos = $certs.filter('[data-impreso="1"]').length;
                $(this).text(`${impresos} de ${$certs.length} impresos`)
                    .toggleClass('bg-success', impresos > 0 && impresos === $certs.length)
                    .toggleClass('bg-secondary', !(impresos > 0 && impresos === $certs.length));
            });
        }

        async function registrarImpresion($wrappers, impreso) {
            const items = $wrappers.toArray().map(w => ({ idOfertaOficial: $(w).data('oferta'), dni: String($(w).data('dni')) }));
            const resp = await fetch('/ciie/calificaciones/certificados/impresion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items, impreso })
            });
            const data = await resp.json().catch(() => ({ error: 'Respuesta inesperada del servidor (¿se cerró la sesión?).' }));
            if (!resp.ok || !data.success) throw new Error(data.error || 'No se pudo registrar la impresión.');
            const fecha = impreso ? new Date().toISOString() : '';
            $wrappers.each(function () {
                const $estado = $(this).find('.estado-impresion');
                $(this).attr('data-impreso', impreso ? '1' : '0');
                $estado.attr('data-fecha', fecha);
                if (impreso) $estado.attr('data-veces', Number($estado.attr('data-veces') || 0) + 1);
                pintarEstadoImpresion(this);
            });
            actualizarResumenes();
        }

        function ajustarNombresCertificado() {
            document.querySelectorAll('.cert-nombre').forEach(el => {
                el.style.fontSize = '';
                const contenedor = el.parentElement;
                let fontSize = parseFloat(getComputedStyle(el).fontSize);
                let intentos = 0;
                while (el.scrollWidth > contenedor.clientWidth && fontSize > 10 && intentos < 30) {
                    fontSize -= 0.5;
                    el.style.fontSize = fontSize + 'px';
                    intentos++;
                }
            });
        }

        let ordenAlfabetico = false;
        let ordenOriginal = [];
        let contenedorAlfabetico = null;

        function capturarOrdenOriginal() {
            ordenOriginal = Array.from(document.querySelectorAll('.cert-wrapper')).map(el => ({
                el,
                parent: el.parentElement
            }));
        }

        function ordenarPorApellido() {
            const wrappers = Array.from(document.querySelectorAll('.cert-wrapper'));
            wrappers.sort((a, b) => (a.dataset.nombre || '').localeCompare(b.dataset.nombre || '', 'es'));

            if (!contenedorAlfabetico) {
                contenedorAlfabetico = document.createElement('div');
                contenedorAlfabetico.className = 'certs-container';
                document.querySelector('.container').appendChild(contenedorAlfabetico);
            }
            wrappers.forEach(w => contenedorAlfabetico.appendChild(w));
            document.querySelectorAll('.curso-grupo').forEach(g => g.style.display = 'none');
            contenedorAlfabetico.style.display = '';
        }

        function ordenarPorCurso() {
            ordenOriginal.forEach(({ el, parent }) => parent.appendChild(el));
            if (contenedorAlfabetico) contenedorAlfabetico.style.display = 'none';
            document.querySelectorAll('.curso-grupo').forEach(g => g.style.display = '');
        }

        $(document).ready(function () {
            const actualizarContador = () => $('#contadorSeleccionados').text($('.check-cert:checked').length);
            actualizarContador();
            ajustarNombresCertificado();
            capturarOrdenOriginal();

            $(document).on('change', '.check-cert', function () {
                const $wrapper = $(`[data-cert-id="${$(this).data('cert-id')}"]`);
                this.checked ? $wrapper.removeClass('deseleccionado') : $wrapper.addClass('deseleccionado');
                actualizarContador();
            });

            $('#btnSelTodos').on('click', () => {
                const todos = $('.check-cert').length === $('.check-cert:checked').length;
                $('.check-cert').prop('checked', !todos).trigger('change');
            });

            $('#btnOrdenAlpha').on('click', function () {
                ordenAlfabetico = !ordenAlfabetico;
                if (ordenAlfabetico) {
                    ordenarPorApellido();
                    $(this).html('<i class="bi bi-sort-alpha-down me-1"></i>Ordenar por curso');
                } else {
                    ordenarPorCurso();
                    $(this).html('<i class="bi bi-sort-alpha-down me-1"></i>Ordenar por apellido');
                }
                ajustarNombresCertificado();
            });

            document.querySelectorAll('.cert-wrapper').forEach(pintarEstadoImpresion);
            actualizarResumenes();

            $('#btnSelPendientes').on('click', () => {
                $('.cert-wrapper').each(function () {
                    const pendiente = $(this).attr('data-impreso') !== '1';
                    $(this).find('.check-cert').prop('checked', pendiente).trigger('change');
                });
            });

            $(document).on('click', '.btn-toggle-impreso', async function () {
                const $w = $(this).closest('.cert-wrapper');
                try {
                    await registrarImpresion($w, $w.attr('data-impreso') !== '1');
                } catch (e) {
                    Swal.fire('Error', e.message, 'error');
                }
            });

            // Después de imprimir se pregunta si salió bien, y recién ahí se registra:
            // el navegador no avisa si la impresión se canceló o falló.
            $('#btnImprimir').on('click', async () => {
                const $seleccionados = $('.check-cert:checked').closest('.cert-wrapper');
                if ($seleccionados.length === 0) {
                    Swal.fire('Nada para imprimir', 'Seleccioná al menos un certificado.', 'info');
                    return;
                }
                window.print();

                const $registrables = $seleccionados.filter('[data-inscripcion="1"]');
                const sinInscripcion = $seleccionados.length - $registrables.length;
                if ($registrables.length === 0) return;

                const r = await Swal.fire({
                    icon: 'question',
                    title: '¿Se imprimieron bien?',
                    html: `Se van a registrar como impresos <b>${$registrables.length}</b> certificado(s).`
                        + (sinInscripcion ? `<br><small class="text-warning">${sinInscripcion} no se pueden registrar porque no tienen inscripción en el sistema.</small>` : ''),
                    showCancelButton: true,
                    confirmButtonText: 'Sí, registrar',
                    cancelButtonText: 'No, no registrar'
                });
                if (!r.isConfirmed) return;
                try {
                    await registrarImpresion($registrables, true);
                    // Ya impresos: se destildan para que no vuelvan a salir en la próxima impresión.
                    $registrables.find('.check-cert').prop('checked', false).trigger('change');
                    Swal.fire({ icon: 'success', title: 'Registrado', timer: 1400, showConfirmButton: false });
                } catch (e) {
                    Swal.fire('Error', e.message, 'error');
                }
            });
        });

        window.addEventListener('resize', ajustarNombresCertificado);
        window.addEventListener('beforeprint', ajustarNombresCertificado);
    </script>
</body>
</html>