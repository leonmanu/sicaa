<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Mis Cursos</title>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <style>
        #tablaCursosDocente td,
        #tablaCursosDocente th {
            vertical-align: middle;
        }
    </style>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

    <div class="container py-5">
        <div class="row mb-4">
            <div class="col-md-8">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a href="/cargo/todos" class="text-decoration-none">Mis Cargos</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Mis Cursos</li>
                    </ol>
                </nav>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>
                    Mis Cursos
                </h2>
                <p class="text-muted mb-0">Vista personal - Consultá con tu CIIE antes de modificar</p>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-dark border-secondary shadow-sm">
                    <div class="card-body py-2 px-3">
                        <small class="text-muted text-uppercase d-block" style="font-size: 0.7rem;">Cursos totales</small>
                        <span class="h4 fw-bold mb-0"><%= cursosPersonales.length %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-dark text-white">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="tablaCursosDocente" class="table table-dark table-hover align-middle mb-0">
                        <thead class="bg-black text-muted small text-uppercase">
                            <tr>
                                <th>Año</th>
                                <th>Proposición</th>
                                <th>Cargo</th>
                                <th>Inicio</th>
                                <th>Estado</th>
                                <th class="text-center pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (cursosPersonales && cursosPersonales.length > 0) { %>
                                <% cursosPersonales.forEach(c => {
                                    const tieneOferta = !!c.idOfertaOficial;
                                    const puedeGestionar = !c.esInvitado;
                                    const apellidoTitular = c.esInvitado ? c.cargoId?.ocupante?.usuarioId?.referenciaId?.apellido : null;
                                %>
                                    <tr>
                                        <td class="fw-bold text-info"><%= c.anio %> • I<%= c.itinerario %></td>
                                        <td>
                                            <b><%= c.nombrePropuesta || 'Sin nombre' %></b>
                                            <% if (c.esInvitado) { %>
                                                <span class="badge bg-info text-dark ms-1" title="Sos formador/a invitado/a en este curso: podés consultarlo, pero la asistencia y las calificaciones las maneja el/la titular.">
                                                    <i class="bi bi-person-plus-fill me-1"></i>Invitado/a
                                                </span>
                                            <% } %>
                                            <br>
                                            <small class="text-muted"><%= c.dispositivo || 'Dispositivo' %></small>
                                        </td>
                                        <td>
                                            <%= c.cargoId?.clave || '-' %>
                                            <% if (apellidoTitular) { %>
                                                <br><small class="text-muted"><%= apellidoTitular %></small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (c.encuentros && c.encuentros.length > 0 && c.encuentros[0].fecha) {
                                                const f = new Date(c.encuentros[0].fecha);
                                                const fechaCorta = f.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', timeZone: 'America/Argentina/Buenos_Aires' })
                                                    + ' ' + f.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Argentina/Buenos_Aires' });
                                            %>
                                                <%= fechaCorta %>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (c.estado === 'pendiente') { %>
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                            <% } else if (c.estado === 'vinculado') { %>
                                                <span class="badge bg-success">Vinculado</span>
                                            <% } else if (c.estado === 'modificacion_pendiente') { %>
                                                <span class="badge bg-info">Cambios Pendientes</span>
                                            <% } else if (c.estado === 'eliminacion_pendiente') { %>
                                                <span class="badge bg-danger">Eliminación Pendiente</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary"><%= c.estado %></span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end bg-dark border-secondary">
                                                    <% if (tieneOferta) { %>
                                                        <li>
                                                            <a class="dropdown-item text-white" href="/inscripto/curso/<%= c.idOfertaOficial %>">
                                                                <i class="bi bi-people-fill me-2 text-primary"></i>Ver alumnos
                                                            </a>
                                                        </li>
                                                        <% if (c.enlaceInscripcion) { %>
                                                        <li>
                                                            <button class="dropdown-item text-white btn-copiar-enlace" data-link="<%= c.enlaceInscripcion %>">
                                                                <i class="bi bi-link-45deg me-2 text-info"></i>Copiar enlace
                                                            </button>
                                                        </li>
                                                        <% } %>
                                                        <li>
                                                            <a class="dropdown-item text-white" href="/curso/flyer/<%= c.idOfertaOficial %>" target="_blank">
                                                                <i class="bi bi-image me-2 text-warning"></i>Ver flyer
                                                            </a>
                                                        </li>
                                                    <% } %>
                                                    <% if (puedeGestionar) { %>
                                                        <% if (tieneOferta) { %><li><hr class="dropdown-divider border-secondary"></li><% } %>
                                                        <li>
                                                            <a class="dropdown-item text-success" href="/curso/<%= c.cargoId?.clave %>/<%= c.cargoId?.ciieId?.clave %>/?editar=<%= c._id %>">
                                                                <i class="bi bi-pencil me-2"></i>Editar
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <button class="dropdown-item text-danger btn-eliminar-curso-docente"
                                                                    data-id="<%= c._id %>">
                                                                <i class="bi bi-trash me-2"></i>Eliminar
                                                            </button>
                                                        </li>
                                                    <% } else if (!tieneOferta) { %>
                                                        <li><span class="dropdown-item-text text-muted small">Sin acciones disponibles</span></li>
                                                    <% } %>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <p class="text-muted mb-0">No hay cursos asignados a tus cargos.</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-4 p-3 bg-dark border border-info rounded">
            <div class="alert alert-info mb-0" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Información:</strong> Cuando edites un curso, quedará pendiente de aprobación por parte de tu CIIE.
                Los cambios solo serán efectivos una vez aprobados.
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>
    <script>
        $(document).ready(function () {
            // Copiar enlace de inscripción
            $(document).on('click', '.btn-copiar-enlace', function () {
                const link = $(this).data('link');
                navigator.clipboard.writeText(link).then(() => {
                    Swal.fire({ icon: 'success', title: 'Enlace copiado', showConfirmButton: false, timer: 1200 });
                });
            });

            // Eliminar curso
            $(document).on('click', '.btn-eliminar-curso-docente', function () {
                const cursoId = $(this).data('id');
                const $row = $(this).closest('tr');
                const nombreCurso = $row.find('td:nth-child(2)').text().trim();

                Swal.fire({
                    title: '¿Eliminar curso?',
                    html: `<small class="text-muted">Se eliminará "${nombreCurso}" y todos sus encuentros relacionados.</small>`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/curso/${cursoId}`,
                            method: 'DELETE',
                            success: function () {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Curso eliminado',
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => location.reload());
                            },
                            error: function (xhr) {
                                const mensaje = xhr.responseJSON?.error || 'No se pudo eliminar el curso.';
                                Swal.fire('Error', mensaje, 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
    <%- include('../../partials/footer') %>
</body>
</html>
