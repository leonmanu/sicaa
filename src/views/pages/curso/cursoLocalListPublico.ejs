<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title><%= title || 'Oferta de Cursos' %></title>
    <style>
        .curso-card {
            background-color: #161b22;
            border: 1px solid #30363d;
            border-radius: 10px;
            transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .curso-card:hover {
            transform: translateY(-3px);
            border-color: #58a6ff;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
        }
        .curso-nombre { font-size: 1.05rem; line-height: 1.3; }
        .curso-detalle { font-size: 0.85rem; }
        .curso-detalle li { display: flex; align-items: baseline; gap: 0.5rem; padding: 2px 0; }
        .curso-detalle i { width: 1.1em; flex-shrink: 0; }
        #buscador:focus { border-color: #58a6ff; box-shadow: 0 0 0 0.2rem rgba(88,166,255,.15); }
        .filtro-activo { border-color: #58a6ff !important; }
        #contadorResultados { font-size: 0.8rem; }
        .sin-resultados { display: none; }

        /* Modal "Ver flyer": el flyer se embebe a tamaño fijo (540x675) y se
           escala visualmente para entrar en el modal, igual que el resto de
           las vistas que embeben flyers. */
        #modalFlyerWrapper {
            width: 100%;
            max-width: 460px;
            aspect-ratio: 540 / 675;
            overflow: hidden;
            position: relative;
            background: #1a1a2e;
            margin: 0 auto;
        }
        #modalFlyerIframe {
            width: 540px;
            height: 675px;
            border: none;
            transform-origin: top left;
            position: absolute;
            top: 0;
            left: 0;
        }
    </style>
</head>
<body>

    <%
        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);

        function primeraFechaDe(curso) {
            const primerEncuentro = (curso.encuentros || [])[0];
            return primerEncuentro?.fecha ? new Date(primerEncuentro.fecha) : null;
        }

        function inscripcionVencida(curso) {
            if (!curso.fechaFinInscripcion) return false;
            return new Date(curso.fechaFinInscripcion) < hoy;
        }

        const cursosVinculados = cursosLocales
            .filter(c => {
                if (c.estado !== 'vinculado') return false;
                if (!c.encuentros || c.encuentros.length === 0) return true;
                return new Date(c.encuentros[0].fecha) >= hoy;
            })
            .sort((a, b) => {
                const fa = primeraFechaDe(a);
                const fb = primeraFechaDe(b);
                if (!fa && !fb) return 0;
                if (!fa) return 1;
                if (!fb) return -1;
                return fa - fb;
            });

        function diaDictadoDe(curso) {
            const primerEncuentro = (curso.encuentros || [])[0];
            if (!primerEncuentro?.fecha) return '';
            const fechaObj = new Date(primerEncuentro.fecha);
            const diaSemana = fechaObj.toLocaleDateString('es-AR', { weekday: 'long', timeZone: 'America/Argentina/Buenos_Aires' });
            return diaSemana.charAt(0).toUpperCase() + diaSemana.slice(1);
        }

        function horaDictadoDe(curso) {
            const primerEncuentro = (curso.encuentros || [])[0];
            if (!primerEncuentro?.fecha) return '';
            if (primerEncuentro.horaInicio) {
                return primerEncuentro.horaFin
                    ? `${primerEncuentro.horaInicio} a ${primerEncuentro.horaFin}`
                    : primerEncuentro.horaInicio;
            }
            const horaTexto = new Date(primerEncuentro.fecha).toLocaleTimeString('es-AR', {
                hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Argentina/Buenos_Aires'
            });
            return horaTexto !== '00:00' ? horaTexto : '';
        }

        const FORMATO_LABELS = { 1: 'Sin definir', 2: 'Presencial', 3: 'Virtual', 4: 'Virtual', 5: 'Combinado' };
        function formatoDe(curso) {
            const formatoDictado = (curso.publicacionDrupal?.formatoDictado || '').replace(/\s*\(\d+\)\s*$/, '').trim();
            return formatoDictado || FORMATO_LABELS[String(curso.idformato)] || '';
        }

        function fechaInicioDe(curso) {
            const fecha = primeraFechaDe(curso);
            if (!fecha) return '';
            return fecha.toLocaleDateString('es-AR', {
                day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'America/Argentina/Buenos_Aires'
            });
        }

        const ETIQUETAS_DISPOSITIVO = {
            'Taller Fuera de Servicio': 'Taller'
        };
        function etiquetaDispositivoDe(dispositivo) {
            return ETIQUETAS_DISPOSITIVO[dispositivo] || dispositivo;
        }

        const COLORES_DISPOSITIVO = {
            'Taller en Servicio': '#f47920',
            'Taller Fuera de Servicio': '#5c6bc0',
            'Seminario': '#00adc5',
            'Seminario Distancia': '#0a8fa0',
            'Extensión CIIE': '#8e6fce',
            'MADP + Ateneo': '#c2185b',
            'Ateneo Distancia': '#ad1457',
            'Curso Distancia': '#2e7d32'
        };
        const PALETA_DISPOSITIVO_FALLBACK = ['#0d6efd', '#fd7e14', '#20c997', '#6f42c1', '#d63384', '#198754'];
        function colorDispositivoDe(dispositivo) {
            if (COLORES_DISPOSITIVO[dispositivo]) return COLORES_DISPOSITIVO[dispositivo];
            // Color estable (por hash) para dispositivos que no están en la lista de arriba
            let hash = 0;
            for (let i = 0; i < dispositivo.length; i++) hash = dispositivo.charCodeAt(i) + ((hash << 5) - hash);
            return PALETA_DISPOSITIVO_FALLBACK[Math.abs(hash) % PALETA_DISPOSITIVO_FALLBACK.length];
        }
    %>

    <!-- HEADER PÚBLICO -->
    <nav class="navbar navbar-dark bg-dark border-bottom border-secondary border-opacity-25 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="#">
                <img src="/img/LogoSicaa.png" alt="SICAA" height="18" class="me-2">
                <span>SICAA</span>
            </a>
            <span class="text-muted small d-none d-sm-inline">
                <i class="bi bi-building me-1"></i><%= ciieNombre %>
            </span>
        </div>
    </nav>

    <div class="container py-4">

        <!-- ENCABEZADO -->
        <div class="mb-4">
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>Oferta de Cursos
            </h1>
            <p class="text-muted mb-0">
                <i class="bi bi-building me-1"></i><%= ciieNombre %>
                <span class="ms-2 badge bg-secondary"><%= ciieClave %></span>
            </p>
        </div>

        <!-- BUSCADOR Y FILTROS -->
        <div class="card mb-4" style="background-color:#161b22; border:1px solid #30363d;">
            <div class="card-body py-3">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-5">
                        <label class="form-label small text-muted mb-1">Buscar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" id="buscador"
                                   class="form-control bg-dark border-secondary text-white"
                                   placeholder="Nombre, formador/a, área...">
                        </div>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small text-muted mb-1">Dispositivo</label>
                        <select id="filtroDispositivo" class="form-select form-select-sm bg-dark border-secondary text-white">
                            <option value="">Todos</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small text-muted mb-1">Área</label>
                        <select id="filtroArea" class="form-select form-select-sm bg-dark border-secondary text-white">
                            <option value="">Todas</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small text-muted mb-1">Día</label>
                        <select id="filtroDia" class="form-select form-select-sm bg-dark border-secondary text-white">
                            <option value="">Todos</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-1 d-flex align-items-end">
                        <button id="btnLimpiar" class="btn btn-sm btn-outline-secondary w-100" title="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="mt-2 d-flex align-items-center gap-3">
                    <span id="contadorResultados" class="text-muted"></span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="soloDisponibles" checked>
                        <label class="form-check-label small text-muted" for="soloDisponibles">Solo con inscripción abierta</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- GRILLA DE CURSOS -->
        <% if (cursosVinculados.length === 0) { %>
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-x fs-1 d-block mb-3 opacity-25"></i>
                <p class="mb-0">No hay cursos disponibles en este momento.</p>
            </div>
        <% } else { %>

            <div id="gridCursos" class="row g-3">
                <% cursosVinculados.forEach(c => {
                    const disponible = String(c.disponible || '').toUpperCase() === 'S';
                    const vencida = inscripcionVencida(c);
                    const area = c.cargoId?.areaId?.nombre || c.cargoId?.areaId?.nombreCorto || '';
                    const nivel = c.cargoId?.areaId?.nivel || '';
                    const dia = diaDictadoDe(c);
                    const hora = horaDictadoDe(c);
                    const formato = formatoDe(c);
                    const fechaInicio = fechaInicioDe(c);
                %>
                <div class="col-12 col-md-6 col-lg-4 curso-item"
                     data-nombre="<%= (c.nombrePropuesta || '').toLowerCase() %>"
                     data-formador="<%= (c.formadorAbc || '').toLowerCase() %>"
                     data-area="<%= area.toLowerCase() %>"
                     data-dispositivo="<%= c.dispositivo || '' %>"
                     data-dia="<%= dia %>"
                     data-disponible="<%= disponible ? '1' : '0' %>">
                    <div class="card curso-card h-100">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <span class="badge" style="background-color: <%= colorDispositivoDe(c.dispositivo || '') %>;"><%= etiquetaDispositivoDe(c.dispositivo) %></span>
                                <% if (nivel) { %><span class="badge bg-info text-dark"><%= nivel %></span><% } %>
                                <% if (formato) { %><span class="badge bg-dark border border-secondary text-light"><%= formato %></span><% } %>
                            </div>

                            <h6 class="curso-nombre fw-bold mb-2"><%= c.nombrePropuesta %></h6>

                            <ul class="list-unstyled curso-detalle text-muted mb-3 flex-grow-1">
                                <% if (area) { %><li><i class="bi bi-tag"></i><span><%= area %></span></li><% } %>
                                <% if (c.formadorAbc) { %><li><i class="bi bi-person"></i><span><%= c.formadorAbc %></span></li><% } %>
                                <% if (dia) { %><li><i class="bi bi-calendar-event"></i><span><%= dia %><% if (hora) { %> · <%= hora %> hs<% } %></span></li><% } %>
                                <% if (fechaInicio) { %><li><i class="bi bi-calendar2-check"></i><span>Inicia el <%= fechaInicio %></span></li><% } %>
                                <% if (c.cantidadHoras) { %><li><i class="bi bi-clock-history"></i><span><%= c.cantidadHoras %> hs. reloj<% if (c.cantidadEncuentros) { %> · <%= c.cantidadEncuentros %> encuentros<% } %></span></li><% } %>
                                <% if (c.cupo) { %><li><i class="bi bi-people"></i><span><%= c.cantidadInscriptos || 0 %>/<%= c.cupo %> inscriptos/as</span></li><% } %>
                            </ul>

                            <div class="d-grid gap-2">
                                
                                <% if (disponible && c.enlaceInscripcion) { %>
                                <a href="<%= c.enlaceInscripcion %>" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-success btn-sm fw-semibold">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Inscribirse
                                </a>
                                <% } else { %>
                                <button class="btn btn-outline-secondary btn-sm" disabled>
                                    <i class="bi bi-lock me-1"></i>Inscripción no disponible
                                </button>
                                <% } %>
                                <% if (c.idOfertaOficial) { %>
                                <button type="button" class="btn btn-outline-light btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#modalFlyer"
                                        data-oferta-id="<%= c.idOfertaOficial %>"
                                        data-nombre="<%= c.nombrePropuesta %>">
                                    <i class="bi bi-image me-1"></i>Ver flyer
                                </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>

            <!-- MODAL: VER FLYER -->
            <div class="modal fade" id="modalFlyer" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-dark border-secondary">
                        <div class="modal-header border-secondary">
                            <h6 class="modal-title" id="modalFlyerTitulo">Flyer</h6>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div id="modalFlyerWrapper">
                                <iframe id="modalFlyerIframe" src="" loading="lazy" title="Flyer"></iframe>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SIN RESULTADOS -->
            <div id="sinResultados" class="text-center py-5 text-muted sin-resultados">
                <i class="bi bi-search fs-1 d-block mb-3 opacity-25"></i>
                <p class="mb-1">No se encontraron cursos con esos criterios.</p>
                <button class="btn btn-sm btn-outline-secondary mt-2" id="btnLimpiarSinResultados">
                    <i class="bi bi-x-circle me-1"></i>Limpiar filtros
                </button>
            </div>

        <% } %>

    </div>

    <%- include('../../partials/footer') %>

    <%- include('../../partials/scripts') %>
    <script>
    // ─── Modal "Ver flyer": carga el iframe recién al abrir (nunca todos a la vez) ──
    (function () {
        const modalEl      = document.getElementById('modalFlyer');
        const iframe       = document.getElementById('modalFlyerIframe');
        const wrapper      = document.getElementById('modalFlyerWrapper');
        const tituloEl     = document.getElementById('modalFlyerTitulo');
        if (!modalEl || !iframe || !wrapper) return;

        function escalarModalFlyer() {
            const scale = wrapper.offsetWidth / 540;
            iframe.style.transform = 'scale(' + scale + ')';
        }

        modalEl.addEventListener('show.bs.modal', function (event) {
            const boton = event.relatedTarget;
            if (!boton) return;
            tituloEl.textContent = boton.dataset.nombre || 'Flyer';
            iframe.src = `/curso/flyer/${boton.dataset.ofertaId}?bare=true`;
        });
        modalEl.addEventListener('shown.bs.modal', escalarModalFlyer);
        modalEl.addEventListener('hidden.bs.modal', function () {
            iframe.src = ''; // libera el iframe al cerrar, no queda cargado de fondo
        });
        window.addEventListener('resize', escalarModalFlyer);
    })();

    $(document).ready(function () {

        const $items    = $('.curso-item');
        const $grid     = $('#gridCursos');
        const $sin      = $('#sinResultados');
        const $contador = $('#contadorResultados');

        // ─── Poblar filtros ───────────────────────────────────────────────────
        const ORDEN_DIAS = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
        const dispositivos = [...new Set($items.map((_, el) => $(el).data('dispositivo')).get().filter(Boolean))].sort();
        const areas        = [...new Set($items.map((_, el) => $(el).data('area')).get().filter(Boolean))].sort();
        const dias         = [...new Set($items.map((_, el) => $(el).data('dia')).get().filter(Boolean))]
            .sort((a, b) => ORDEN_DIAS.indexOf(a) - ORDEN_DIAS.indexOf(b));

        dispositivos.forEach(d => $('#filtroDispositivo').append(`<option value="${d}">${d}</option>`));
        areas.forEach(a => $('#filtroArea').append(`<option value="${a}">${a}</option>`));
        dias.forEach(d => $('#filtroDia').append(`<option value="${d}">${d}</option>`));

        // ─── Filtrar ──────────────────────────────────────────────────────────
        function filtrar() {
            const texto       = $('#buscador').val().toLowerCase().trim();
            const dispositivo = $('#filtroDispositivo').val();
            const area        = $('#filtroArea').val().toLowerCase();
            const dia         = $('#filtroDia').val();
            const soloDisp    = $('#soloDisponibles').is(':checked');

            let visibles = 0;

            $items.each(function () {
                const $el = $(this);
                const matchTexto  = !texto ||
                    $el.data('nombre').includes(texto) ||
                    $el.data('formador').includes(texto) ||
                    $el.data('area').includes(texto);
                const matchDisp   = !dispositivo || $el.data('dispositivo') === dispositivo;
                const matchArea   = !area || $el.data('area').includes(area);
                const matchDia    = !dia || $el.data('dia') === dia;
                const matchSoloD  = !soloDisp || $el.data('disponible') === 1 || $el.data('disponible') === '1';

                const visible = matchTexto && matchDisp && matchArea && matchDia && matchSoloD;
                $el.toggle(visible);
                if (visible) visibles++;
            });

            $contador.text(visibles === $items.length ? `${visibles} cursos` : `${visibles} de ${$items.length} cursos`);

            if ($items.length > 0) {
                $sin.toggle(visibles === 0);
                $grid.toggle(visibles > 0);
            }

            // Resaltar filtros activos
            ['#filtroDispositivo', '#filtroArea', '#filtroDia'].forEach(sel => {
                $(sel).toggleClass('filtro-activo', !!$(sel).val());
            });
            $('#buscador').toggleClass('filtro-activo', !!$('#buscador').val());
        }

        // ─── Limpiar ──────────────────────────────────────────────────────────
        function limpiar() {
            $('#buscador').val('');
            $('#filtroDispositivo, #filtroArea, #filtroDia').val('');
            $('#soloDisponibles').prop('checked', true);
            filtrar();
        }

        // ─── Eventos ──────────────────────────────────────────────────────────
        $('#buscador').on('input', filtrar);
        $('#filtroDispositivo, #filtroArea, #filtroDia, #soloDisponibles').on('change', filtrar);
        $('#btnLimpiar, #btnLimpiarSinResultados').on('click', limpiar);

        // Inicializar contador
        filtrar();
    });
    </script>
</body>
</html>
