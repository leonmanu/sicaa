<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Estadísticas de cursos</title>
    <style>
        .filter-select {
            background-color: #2b3035;
            color: #dee2e6;
            border: 1px solid #495057;
            border-radius: 5px;
            padding: 2px 5px;
            font-size: 0.8rem;
            margin-left: 10px;
        }
        #tablaEstadisticas td, #tablaEstadisticas th {
            vertical-align: middle;
        }
    </style>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

    <div class="container-fluid py-5 px-4">
        <div class="row mb-4 align-items-center">
            <div class="col-md-8">
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-bar-chart-fill me-2 text-primary"></i>
                    Estadísticas de cursos
                </h2>
                <p class="text-muted mb-0">
                    <% if (esCiie) { %>
                        Inscriptos, asistencia y aprobados de todos los cursos del CIIE.
                    <% } else { %>
                        Inscriptos, asistencia y aprobados de tus cursos (propios e invitado/a).
                    <% } %>
                </p>
            </div>
        </div>

        <div class="card bg-dark border-secondary shadow-sm mb-4">
            <div class="card-body py-3">
                <form action="/curso/estadisticas" method="get" class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label text-light small">Itinerario</label>
                        <select name="itinerarioClave" class="form-select" id="itinerarioClave" <%= itinerarios.length ? '' : 'disabled' %>>
                            <% if (itinerarios.length === 0) { %>
                                <option value="">No hay itinerarios disponibles</option>
                            <% } else { %>
                                <% itinerarios.forEach(item => { %>
                                    <% const selected = seleccion && item.anio === seleccion.anio && item.itinerario === seleccion.itinerario; %>
                                    <option value="<%= item.anio %>|<%= item.itinerario %>" <%= selected ? 'selected' : '' %>>
                                        <%= item.etiqueta %> (<%= item.cantidadCursos %> curso/s)
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                        <input type="hidden" name="anio" id="anio" value="<%= seleccion?.anio ?? '' %>">
                        <input type="hidden" name="itinerario" id="itinerario" value="<%= seleccion?.itinerario ?? '' %>">
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100" <%= itinerarios.length ? '' : 'disabled' %>>
                            <i class="bi bi-search me-1"></i>Ver itinerario
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <% if (!seleccion || cursos.length === 0) { %>
            <div class="alert alert-secondary">No hay cursos para mostrar en este itinerario.</div>
        <% } else { %>

            <div class="row mb-4 g-3">
                <div class="col-6 col-md-3">
                    <div class="card bg-dark border-secondary shadow-sm">
                        <div class="card-body py-2 px-3">
                            <small class="text-muted text-uppercase d-block" style="font-size:0.7rem;">Cursos</small>
                            <span class="h4 fw-bold mb-0"><%= cursos.length %></span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card bg-dark border-secondary shadow-sm">
                        <div class="card-body py-2 px-3">
                            <small class="text-muted text-uppercase d-block" style="font-size:0.7rem;">Inscriptos</small>
                            <span class="h4 fw-bold mb-0"><%= cursos.reduce((s, c) => s + c.cantidadInscriptos, 0) %></span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card bg-dark border-secondary shadow-sm">
                        <div class="card-body py-2 px-3">
                            <small class="text-muted text-uppercase d-block" style="font-size:0.7rem;">Cerrados</small>
                            <span class="h4 fw-bold mb-0"><%= cursos.filter(c => c.cierreAdministrativo?.cerrado).length %> / <%= cursos.length %></span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card bg-dark border-secondary shadow-sm">
                        <div class="card-body py-2 px-3">
                            <small class="text-muted text-uppercase d-block" style="font-size:0.7rem;">Aprobados</small>
                            <span class="h4 fw-bold mb-0"><%= cursos.reduce((s, c) => s + c.cantidadAprobados, 0) %></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <span class="text-muted small">Filtrar por:</span>
                <span id="filtroArea"></span>
                <span id="filtroDispositivo"></span>
            </div>

            <%
                const SIGLAS_DISPOSITIVO = {
                    'Taller en Servicio': 'TES',
                    'Taller Fuera de Servicio': 'TFS',
                    'Seminario': 'SEM',
                    'Seminario Distancia': 'SED',
                    'Extensión CIIE': 'EXT',
                    'Curso Distancia': 'CDI',
                    'Ateneo Distancia': 'ATD',
                    'MADP + Ateneo': 'MADP'
                };
                function siglaDispositivoDe(dispositivo) {
                    return SIGLAS_DISPOSITIVO[dispositivo] || dispositivo;
                }
                function colorAsistenciaDe(enc) {
                    if (enc.sinMarcar) return { bg: '#3a4046', fg: '#adb5bd' };
                    if (enc.porcentaje >= 75) return { bg: '#198754', fg: '#fff' };
                    if (enc.porcentaje >= 50) return { bg: '#e0a800', fg: '#212529' };
                    return { bg: '#b02a37', fg: '#fff' };
                }

                // Cada dispositivo puede tener una cantidad distinta de encuentros:
                // se arma una columna por cada número de encuentro que exista en
                // ALGÚN curso del itinerario (E1, E2, ...); al curso que no llega
                // a ese encuentro le queda la celda gris.
                const maxEncuentros = cursos.reduce((max, c) => Math.max(max, c.asistenciaPorEncuentro.length), 0);
                const numerosEncuentro = Array.from({ length: maxEncuentros }, (_, i) => i + 1);

                // Resumen general por columna de encuentro: promedio ponderado
                // (presentes totales / inscriptos totales de los cursos que ya
                // llegaron a ese encuentro y lo marcaron).
                const resumenPorEncuentro = numerosEncuentro.map(num => {
                    let presentesTotal = 0;
                    let inscriptosTotal = 0;
                    cursos.forEach(c => {
                        const enc = c.asistenciaPorEncuentro.find(e => e.numero === num);
                        if (enc && !enc.sinMarcar) {
                            presentesTotal += enc.presentes;
                            inscriptosTotal += c.cantidadInscriptos;
                        }
                    });
                    return {
                        numero: num,
                        presentes: presentesTotal,
                        inscriptos: inscriptosTotal,
                        porcentaje: inscriptosTotal > 0 ? Math.round((presentesTotal / inscriptosTotal) * 100) : null
                    };
                });

                const totalInscriptosGeneral = cursos.reduce((s, c) => s + c.cantidadInscriptos, 0);
                const totalAprobadosGeneral = cursos.reduce((s, c) => s + c.cantidadAprobados, 0);
                const porcentajeAprobadosGeneral = totalInscriptosGeneral > 0
                    ? Math.round((totalAprobadosGeneral / totalInscriptosGeneral) * 100)
                    : null;
            %>
            <div class="card shadow-sm border-0 bg-dark text-white">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="tablaEstadisticas" class="table table-dark table-hover align-middle mb-0">
                            <thead class="bg-black text-muted small text-uppercase">
                                <tr>
                                    <th>Curso</th>
                                    <th>Área</th>
                                    <th>Disp.</th>
                                    <th>Inscriptos</th>
                                    <% numerosEncuentro.forEach(num => { %>
                                        <th class="text-center">E<%= num %></th>
                                    <% }) %>
                                    <th>Aprobados</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% cursos.forEach(c => { %>
                                    <tr>
                                        <td>
                                            <div class="fw-bold" style="font-size:0.85rem; max-width:260px;">
                                                <% if (c.cierreAdministrativo?.cerrado) { %>
                                                    <i class="bi bi-lock-fill text-success me-1" title="Cerrado<%= c.cierreAdministrativo?.fecha ? ' el ' + new Date(c.cierreAdministrativo.fecha).toLocaleDateString('es-AR') : '' %>"></i>
                                                <% } else { %>
                                                    <i class="bi bi-unlock-fill text-muted me-1" title="Abierto"></i>
                                                <% } %>
                                                <%= c.nombrePropuesta %>
                                            </div>
                                            <small class="text-muted"><%= c.formadorAbc || 'A designar' %></small>
                                        </td>
                                        <td><%= c.claveCargo || '-' %></td>
                                        <td><%= siglaDispositivoDe(c.dispositivo) %></td>
                                        <td data-order="<%= c.cantidadInscriptos %>"><%= c.cantidadInscriptos %></td>
                                        <% numerosEncuentro.forEach(num => {
                                            const enc = c.asistenciaPorEncuentro.find(e => e.numero === num);
                                        %>
                                            <% if (!enc) { %>
                                                <td class="text-center" style="background-color:#22262a;"></td>
                                            <% } else { %>
                                                <% const color = colorAsistenciaDe(enc); %>
                                                <td class="text-center fw-bold"
                                                    style="background-color: <%= color.bg %>; color: <%= color.fg %>;"
                                                    title="Encuentro <%= enc.numero %>: <%= enc.presentes %> presentes, <%= enc.ausentes %> ausentes<%= enc.pendientes ? ', ' + enc.pendientes + ' sin marcar' : '' %>">
                                                    <% if (enc.sinMarcar) { %>
                                                        <span style="font-size:0.75rem;">sin marcar</span>
                                                    <% } else { %>
                                                        <%= enc.presentes %>/<%= c.cantidadInscriptos %> <span style="font-size:0.72rem;">(<%= enc.porcentaje %>%)</span>
                                                    <% } %>
                                                </td>
                                            <% } %>
                                        <% }) %>
                                        <td data-order="<%= c.porcentajeAprobados ?? -1 %>">
                                            <% if (c.porcentajeAprobados === null) { %>
                                                <span class="text-muted small">-</span>
                                            <% } else { %>
                                                <span class="fw-bold"><%= c.cantidadAprobados %></span>
                                                <small class="text-muted">/ <%= c.cantidadInscriptos %> (<%= c.porcentajeAprobados %>%)</small>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                            <tfoot class="bg-black">
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-uppercase small text-muted">Resumen general</td>
                                    <td><%= totalInscriptosGeneral %></td>
                                    <% resumenPorEncuentro.forEach(r => { %>
                                        <td class="text-center">
                                            <% if (r.porcentaje === null) { %>
                                                <span class="text-muted small">-</span>
                                            <% } else { %>
                                                <%= r.presentes %>/<%= r.inscriptos %> <span style="font-size:0.72rem;">(<%= r.porcentaje %>%)</span>
                                            <% } %>
                                        </td>
                                    <% }) %>
                                    <td>
                                        <% if (porcentajeAprobadosGeneral === null) { %>
                                            <span class="text-muted small">-</span>
                                        <% } else { %>
                                            <%= totalAprobadosGeneral %> / <%= totalInscriptosGeneral %> (<%= porcentajeAprobadosGeneral %>%)
                                        <% } %>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/scripts') %>

    <script>
        (function () {
            const select = document.getElementById('itinerarioClave');
            const anioInput = document.getElementById('anio');
            const itinerarioInput = document.getElementById('itinerario');

            function syncHiddenFields() {
                if (!select || !select.value) {
                    if (anioInput) anioInput.value = '';
                    if (itinerarioInput) itinerarioInput.value = '';
                    return;
                }
                const [anio, itinerario] = select.value.split('|');
                anioInput.value = anio || '';
                itinerarioInput.value = itinerario || '';
            }

            if (select) {
                select.addEventListener('change', syncHiddenFields);
                syncHiddenFields();
            }
        })();

        $(document).ready(function () {
            if ($('#tablaEstadisticas').length === 0) return;

            const table = $('#tablaEstadisticas').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                responsive: true,
                paging: false,
                info: true,
                scrollCollapse: true,
                order: [[0, 'asc']],
                dom: '<"d-flex justify-content-between align-items-center mb-3"f>t<"p-3"i>',
                initComplete: function () {
                    // Filtros por columna (Área, Dispositivo, Cerrado), como en el catálogo general.
                    const columnasFiltrables = [
                        { index: 1, contenedor: '#filtroArea', etiqueta: 'Todos los cargos' },
                        { index: 2, contenedor: '#filtroDispositivo', etiqueta: 'Todos los dispositivos' }
                    ];

                    columnasFiltrables.forEach(cfg => {
                        const column = this.api().column(cfg.index);
                        const select = $(`<select class="form-select form-select-sm filter-select d-inline-block w-auto"><option value="">${cfg.etiqueta}</option></select>`)
                            .appendTo(cfg.contenedor)
                            .on('change', function () {
                                const val = $.fn.dataTable.util.escapeRegex($(this).val());
                                column.search(val ? '^' + val + '$' : '', true, false).draw();
                            });

                        column.data().unique().sort().each(function (d) {
                            const textoLimpio = String(d).replace(/<[^>]+>/g, '').trim();
                            if (textoLimpio && select.find(`option[value="${textoLimpio}"]`).length === 0) {
                                select.append(`<option value="${textoLimpio}">${textoLimpio}</option>`);
                            }
                        });
                    });
                }
            });
        });
    </script>
</body>
</html>
