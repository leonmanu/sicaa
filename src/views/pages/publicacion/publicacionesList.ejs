<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Publicaciones en redes sociales</title>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

<%
    const nombreCurso = c => c ? (c.tituloFormulario || c.nombrePropuesta || 'Sin nombre') : '(propuesta eliminada)';
    const fecha = f => f ? new Date(f).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' }) : '';
    const etiqueta = { pendiente: 'Sin publicar', publicando: 'Publicando…', publicado: 'Publicado', error: 'Error' };
    const color = { pendiente: 'secondary', publicando: 'warning text-dark', publicado: 'success', error: 'danger' };
%>

    <div class="container py-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-megaphone me-2 text-info"></i>Publicaciones en redes sociales
                </h2>
                <p class="text-muted mb-0">Lo que se armó para Facebook e Instagram, publicado o pendiente. Para armar una nueva, elegí las propuestas en Flyers.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/curso/flyers" class="btn btn-outline-info btn-sm">
                    <i class="bi bi-collection me-1"></i>Armar publicación
                </a>
                <a href="/plantillas-dispositivo" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-file-earmark-text me-1"></i>Plantillas por dispositivo
                </a>
                <a href="/publicaciones/configuracion" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-share me-1"></i>Redes sociales del CIIE
                </a>
            </div>
        </div>

        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead class="small text-uppercase text-muted">
                            <tr>
                                <th>Propuestas</th>
                                <th>Tipo</th>
                                <th>Creada</th>
                                <th>Facebook</th>
                                <th>Instagram</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!publicaciones || publicaciones.length === 0) { %>
                                <tr><td colspan="6" class="text-center text-muted py-4">Todavía no hay publicaciones.</td></tr>
                            <% } %>
                            <% (publicaciones || []).forEach(pub => { %>
                                <%
                                    const cursos = pub.cursoLocalIds || [];
                                    const partes = (pub.instagram && pub.instagram.partes) || [];
                                    const partesPublicadas = partes.filter(p => p.estado === 'publicado').length;
                                    const partesConError = partes.filter(p => p.estado === 'error').length;
                                    const igPublicado = partesPublicadas > 0;
                                %>
                                <tr data-publicacion-id="<%= pub._id %>">
                                    <td style="max-width: 360px;">
                                        <% if (cursos.length === 1) { %>
                                            <%= nombreCurso(cursos[0]) %>
                                        <% } else { %>
                                            <strong><%= cursos.length %> propuestas</strong>
                                            <div class="small text-muted text-truncate"><%= cursos.slice(0, 3).map(nombreCurso).join(' · ') %><%= cursos.length > 3 ? ' …' : '' %></div>
                                        <% } %>
                                    </td>
                                    <td><span class="badge bg-<%= pub.tipo === 'carrusel' ? 'info text-dark' : 'secondary' %>"><%= pub.tipo === 'carrusel' ? 'Carrusel' : 'Individual' %></span></td>
                                    <td class="small text-muted"><%= fecha(pub.createdAt) %></td>
                                    <td><span class="badge bg-<%= color[pub.facebook?.estado] || 'secondary' %>"><%= etiqueta[pub.facebook?.estado] || 'Sin publicar' %></span></td>
                                    <td>
                                        <% if (partes.length > 1) { %>
                                            <span class="badge bg-<%= partesPublicadas === partes.length ? 'success' : (partesConError ? 'danger' : (partesPublicadas ? 'warning text-dark' : 'secondary')) %>">
                                                <%= partesPublicadas %> de <%= partes.length %> partes
                                            </span>
                                        <% } else if (partes.length === 1) { %>
                                            <span class="badge bg-<%= color[partes[0].estado] %>"><%= etiqueta[partes[0].estado] %></span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/publicaciones/<%= pub._id %>/preview" class="btn btn-outline-info" title="Abrir">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                            <button class="btn btn-outline-danger btn-eliminar-publicacion" title="Eliminar"
                                                data-instagram-publicado="<%= igPublicado %>">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('../../partials/scripts') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).on('click', '.btn-eliminar-publicacion', async function () {
            const fila = $(this).closest('tr');
            const id = fila.data('publicacion-id');
            const instagramPublicado = $(this).data('instagram-publicado') === true;

            const confirm = await Swal.fire({
                icon: 'warning',
                title: '¿Eliminar esta publicación?',
                html: instagramPublicado
                    ? 'Se va a borrar el registro de tu sitio.<br><strong>Los posts de Instagram ya publicados NO se borran automáticamente</strong> (la API de Meta no lo permite): tenés que borrarlos a mano desde la app.'
                    : 'Se va a borrar el registro y, si ya se publicó en Facebook, también ese post.',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            });

            if (!confirm.isConfirmed) return;

            try {
                const response = await fetch(`/publicaciones/${id}`, { method: 'DELETE' });
                const result = await response.json();
                if (!result.success) throw new Error(result.error || 'No se pudo eliminar.');
                fila.remove();
            } catch (error) {
                Swal.fire('Error', error.message, 'error');
            }
        });
    </script>
</body>
</html>
