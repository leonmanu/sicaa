<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Plantillas por dispositivo</title>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

    <div class="container py-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1"><i class="bi bi-file-earmark-text me-2 text-info"></i>Plantillas por dispositivo</h2>
                <p class="text-muted mb-0">Texto reutilizable de "¿Qué son?" y requisitos para cada tipo de curso.</p>
            </div>
            <a href="/publicaciones" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Volver a publicaciones</a>
        </div>

        <div class="card bg-dark border-secondary mb-4">
            <div class="card-header border-secondary fw-bold">Nueva plantilla</div>
            <div class="card-body">
                <form method="POST" action="/plantillas-dispositivo" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Dispositivo (debe coincidir con el valor real del curso, ej. "Seminario")</label>
                        <input type="text" name="dispositivo" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">Nombre en plural (ej. SEMINARIOS)</label>
                        <input type="text" name="nombrePlural" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Hashtag</label>
                        <input type="text" name="hashtag" class="form-control bg-dark text-white border-secondary" placeholder="#SeminariosCIIE">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted">¿Qué son? (una línea por bullet)</label>
                        <textarea name="queSonBullets" rows="4" class="form-control bg-dark text-white border-secondary"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted">Requisitos (opcional, si está vacío usa el default global)</label>
                        <textarea name="requisitosBullets" rows="4" class="form-control bg-dark text-white border-secondary"></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Crear plantilla</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card bg-dark border-secondary">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead class="small text-uppercase text-muted">
                            <tr>
                                <th>Dispositivo</th>
                                <th>Plural</th>
                                <th>Hashtag</th>
                                <th>¿Qué son?</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (plantillas || []).forEach(p => { %>
                                <tr data-id="<%= p._id %>">
                                    <td><%= p.dispositivo %></td>
                                    <td><%= p.nombrePlural %></td>
                                    <td><%= p.hashtag %></td>
                                    <td><small class="text-muted"><%= (p.queSonBullets || []).join(' · ') %></small></td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-danger btn-eliminar-plantilla"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('../../partials/scripts') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).on('click', '.btn-eliminar-plantilla', async function () {
            const fila = $(this).closest('tr');
            const id = fila.data('id');
            const confirm = await Swal.fire({
                icon: 'warning', title: '¿Eliminar esta plantilla?', showCancelButton: true,
                confirmButtonText: 'Sí, eliminar', cancelButtonText: 'Cancelar'
            });
            if (!confirm.isConfirmed) return;
            try {
                const response = await fetch(`/plantillas-dispositivo/${id}`, { method: 'DELETE' });
                const result = await response.json();
                if (!result.success) throw new Error(result.error || 'No se pudo eliminar.');
                fila.remove();
            } catch (error) {
                Swal.fire('Error', error.message, 'error');
            }
        });
    </script>
</body>
</html>
