<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <%- include('../../partials/head') %>
    <title>SICAA - Redes sociales del CIIE</title>
</head>
<body>
    <%- include('../../partials/navbar') %>
    <%- include('../../partials/msj') %>

    <div class="container py-5" style="max-width: 760px;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1"><i class="bi bi-share me-2 text-info"></i>Redes sociales del CIIE</h2>
                <p class="text-muted mb-0">Dónde publica <%= redes.ciieNombre %> y con qué textos fijos.</p>
            </div>
            <a href="/publicaciones" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        </div>

        <!-- ─── Conexión con Meta ─── -->
        <div class="card bg-dark border-secondary mb-4">
            <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                <span class="fw-bold">Conexión con Meta</span>
                <% if (redes.conectado) { %>
                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Conectado</span>
                <% } else { %>
                    <span class="badge bg-secondary">Sin conectar</span>
                <% } %>
            </div>
            <div class="card-body">
                <% if (redes.conectado) { %>
                    <div class="mb-3 small">
                        <div><i class="bi bi-facebook me-2 text-info"></i>Página: <strong><%= redes.facebookPageNombre || redes.facebookPageId %></strong></div>
                        <div class="mt-1"><i class="bi bi-instagram me-2 text-info"></i>Instagram:
                            <% if (redes.instagramId) { %>
                                <strong><%= redes.instagramUsuario ? '@' + redes.instagramUsuario : redes.instagramId %></strong>
                            <% } else { %>
                                <span class="text-warning">no vinculado (solo se podrá publicar en Facebook)</span>
                            <% } %>
                        </div>
                        <% if (redes.verificadoEn) { %>
                            <div class="text-muted mt-1">Verificado el <%= new Date(redes.verificadoEn).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires' }) %></div>
                        <% } %>
                    </div>
                <% } %>

                <label class="form-label small text-muted" for="inputToken">
                    Token de acceso (usuario del sistema del Business Manager del CIIE)
                </label>
                <div class="input-group mb-2">
                    <input type="password" id="inputToken" class="form-control bg-dark text-white border-secondary" autocomplete="off"
                        placeholder="<%= redes.tieneToken ? 'Hay un token guardado — dejalo vacío para seguir usándolo' : 'Pegá acá el token' %>">
                    <button class="btn btn-outline-info" type="button" id="btnVerificar">
                        <i class="bi bi-search me-1"></i>Verificar
                    </button>
                </div>
                <div id="resultadoVerificacion" class="small mb-3"></div>

                <div id="bloqueElegirPagina" class="d-none">
                    <label class="form-label small text-muted" for="selectPagina">Página de Facebook del CIIE</label>
                    <select id="selectPagina" class="form-select bg-dark text-white border-secondary mb-2"></select>
                    <div id="infoInstagram" class="small mb-3"></div>
                    <button class="btn btn-success" type="button" id="btnGuardarConexion">
                        <i class="bi bi-check-lg me-1"></i>Guardar conexión
                    </button>
                </div>

                <% if (redes.tieneToken) { %>
                    <hr class="border-secondary">
                    <button class="btn btn-outline-danger btn-sm" type="button" id="btnDesconectar">
                        <i class="bi bi-x-circle me-1"></i>Desconectar
                    </button>
                <% } %>
            </div>
        </div>

        <!-- ─── Textos fijos ─── -->
        <div class="card bg-dark border-secondary">
            <div class="card-header border-secondary fw-bold">Textos de las publicaciones</div>
            <div class="card-body">
                <form method="POST" action="/publicaciones/configuracion">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Cierre para Facebook</label>
                        <input type="text" name="cierreFacebook" class="form-control bg-dark text-white border-secondary" value="<%= configuracion.cierreFacebook %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Cierre para Instagram</label>
                        <input type="text" name="cierreInstagram" class="form-control bg-dark text-white border-secondary" value="<%= configuracion.cierreInstagram %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Hashtags fijos (uno por línea, ej. #FormaciónDocente, #CIIELaferrere)</label>
                        <textarea name="hashtagsFijos" rows="3" class="form-control bg-dark text-white border-secondary"><%= (configuracion.hashtagsFijos || []).join('\n') %></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Requisitos por defecto (una línea por bullet; se usan si la plantilla del dispositivo no define los suyos)</label>
                        <textarea name="requisitosDefaultBullets" rows="3" class="form-control bg-dark text-white border-secondary"><%= (configuracion.requisitosDefaultBullets || []).join('\n') %></textarea>
                    </div>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Guardar textos</button>
                </form>
            </div>
        </div>
    </div>

    <%- include('../../partials/scripts') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            const paginaActual = '<%= redes.facebookPageId || '' %>';
            const inputToken = document.getElementById('inputToken');
            const resultado = document.getElementById('resultadoVerificacion');
            const bloquePagina = document.getElementById('bloqueElegirPagina');
            const selectPagina = document.getElementById('selectPagina');
            const infoInstagram = document.getElementById('infoInstagram');
            let paginas = [];

            function escapar(texto) {
                const div = document.createElement('div');
                div.textContent = texto == null ? '' : String(texto);
                return div.innerHTML;
            }

            async function postJson(url, body) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body || {})
                });
                const data = await response.json();
                if (!data.success) throw new Error(data.error || 'Error inesperado.');
                return data;
            }

            function mostrarInstagram() {
                const pagina = paginas.find(p => p.id === selectPagina.value);
                if (!pagina) { infoInstagram.innerHTML = ''; return; }
                const avisos = [];
                if (pagina.instagram) {
                    avisos.push(`<span class="text-success"><i class="bi bi-instagram me-1"></i>Instagram vinculado: <strong>${escapar(pagina.instagram.usuario ? '@' + pagina.instagram.usuario : pagina.instagram.id)}</strong></span>`);
                } else {
                    avisos.push('<span class="text-warning"><i class="bi bi-instagram me-1"></i>Meta no informa un Instagram vinculado a esta página (o el token no tiene el permiso instagram_basic). Se podrá publicar solo en Facebook.</span>');
                }
                if (!pagina.puedePublicar) {
                    avisos.push('<span class="text-danger">El token no tiene permiso para crear contenido en esta página.</span>');
                }
                infoInstagram.innerHTML = avisos.join('<br>');
            }

            selectPagina.addEventListener('change', mostrarInstagram);

            document.getElementById('btnVerificar').addEventListener('click', async function () {
                const btn = this;
                btn.disabled = true;
                resultado.innerHTML = '<span class="text-muted">Consultando a Meta...</span>';
                bloquePagina.classList.add('d-none');
                try {
                    const data = await postJson('/publicaciones/configuracion/verificar-meta', { token: inputToken.value });
                    paginas = data.paginas || [];
                    if (paginas.length === 0) {
                        resultado.innerHTML = '<span class="text-warning">El token es válido pero no tiene acceso a ninguna página. Revisá en el Business Manager que el usuario del sistema tenga asignada la página del CIIE.</span>';
                        return;
                    }
                    const vence = data.vence === 'nunca' ? 'no vence' : (data.vence ? 'vence el ' + new Date(data.vence).toLocaleDateString('es-AR') : 'vencimiento desconocido');
                    resultado.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>Token válido (${escapar(vence)}). Elegí la página del CIIE.</span>`;
                    selectPagina.innerHTML = paginas.map(p =>
                        `<option value="${escapar(p.id)}" ${p.id === paginaActual ? 'selected' : ''}>${escapar(p.nombre)}</option>`
                    ).join('');
                    bloquePagina.classList.remove('d-none');
                    mostrarInstagram();
                } catch (error) {
                    resultado.innerHTML = `<span class="text-danger">${escapar(error.message)}</span>`;
                } finally {
                    btn.disabled = false;
                }
            });

            document.getElementById('btnGuardarConexion').addEventListener('click', async function () {
                const btn = this;
                btn.disabled = true;
                try {
                    await postJson('/publicaciones/configuracion/conexion-meta', { token: inputToken.value, pageId: selectPagina.value });
                    await Swal.fire({ icon: 'success', title: 'Redes conectadas', timer: 1500, showConfirmButton: false });
                    window.location.reload();
                } catch (error) {
                    Swal.fire('Error', error.message, 'error');
                    btn.disabled = false;
                }
            });

            const btnDesconectar = document.getElementById('btnDesconectar');
            if (btnDesconectar) {
                btnDesconectar.addEventListener('click', async function () {
                    const confirmacion = await Swal.fire({
                        icon: 'warning',
                        title: '¿Desconectar las redes?',
                        text: 'Se borra el token guardado. No se podrá publicar hasta volver a conectar.',
                        showCancelButton: true,
                        confirmButtonText: 'Desconectar',
                        cancelButtonText: 'Cancelar'
                    });
                    if (!confirmacion.isConfirmed) return;
                    try {
                        await postJson('/publicaciones/configuracion/desconectar-meta');
                        window.location.reload();
                    } catch (error) {
                        Swal.fire('Error', error.message, 'error');
                    }
                });
            }
        })();
    </script>
</body>
</html>
